# Public frontend configuration only. Never add Salesforce credentials or Cognito client secrets.
VITE_API_BASE_URL=/api
VITE_COGNITO_USER_POOL_ID=replace-with-public-user-pool-id
VITE_COGNITO_CLIENT_ID=replace-with-public-app-client-id
VITE_COGNITO_DOMAIN=replace-with-managed-login-domain
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
# Replace only after D-11 in docs/architecture/decision-log.md is approved.
VITE_COGNITO_SCOPE=openid email replace-with-approved-api-scope

# Backend values below are identifiers/settings, not secret values.
SALESFORCE_SECRET_ARN=replace-with-secret-arn
SALESFORCE_API_VERSION=replace-with-approved-version
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:5173
